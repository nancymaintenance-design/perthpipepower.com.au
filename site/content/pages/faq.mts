"kind": "faq",
"container": "<!-- keyword-gap:end --><section class=\"section faq\">\n        <div class=\"shell\">\n          <!-- site-intent:start --><div class=\"intent-content\" data-site-intent><h2>Booking, scope and quotation questions</h2><p>Use this page for questions that apply across services. Fault-specific questions belong on the relevant repair page, where the assessment and service boundaries are explained in more detail. You can enquire without naming a faulty part or collecting photos. The team confirms the proposed visit and written scope before agreed work proceeds.</p><ul class=\"intent-links\"><li><a href=\"plumbing.html\">Choose a plumbing repair</a></li><li><a href=\"electrical.html\">Choose electrical repairs or installation</a></li><li><a href=\"property-management.html\">Work orders and approval for managed properties</a></li><li><a href=\"lighting-installation-perth.html\">Lighting Installation &amp; Repairs Perth questions</a></li><li><a href=\"power-points-perth.html\">Power Point Installation &amp; Repairs Perth questions</a></li><li><a href=\"dishwasher-installation-perth.html\">Dishwasher Installation &amp; Connections Perth questions</a></li><li><a href=\"toilet-installation-perth.html\">Toilet Installation &amp; Replacement Perth questions</a></li><li><a href=\"shower-plumbing-repairs-perth.html\">Shower Plumbing Leak Repairs Perth questions</a></li><li><a href=\"water-pressure-perth.html\">Low Water Pressure &amp; Water Hammer Perth questions</a></li><li><a href=\"ceiling-fans-perth.html\">Ceiling Fan Installation &amp; Repairs Perth questions</a></li><li><a href=\"exhaust-fans-perth.html\">Bathroom Exhaust Fan Replacement Perth questions</a></li><li><a href=\"switchboard-upgrades-perth.html\">Switchboard Repairs &amp; Upgrades Perth questions</a></li><li><a href=\"rcd-testing-perth.html\">RCD Testing &amp; Safety Switch Checks Perth questions</a></li><li><a href=\"emergency-plumber-perth.html\">24-Hour Emergency Plumber Perth questions</a></li><li><a href=\"emergency-electrician-perth.html\">24-Hour Emergency Electrician Perth questions</a></li></ul><details><summary>{{ppp:faq:0:question}}</summary>{{ppp:faq:0:answer}}</details><details><summary>{{ppp:faq:1:question}}</summary>{{ppp:faq:1:answer}}</details><details><summary>{{ppp:faq:2:question}}</summary>{{ppp:faq:2:answer}}</details><details><summary>{{ppp:faq:3:question}}</summary>{{ppp:faq:3:answer}}</details><details><summary>{{ppp:faq:4:question}}</summary>{{ppp:faq:4:answer}}</details><details><summary>{{ppp:faq:5:question}}</summary>{{ppp:faq:5:answer}}</details><details><summary>{{ppp:faq:6:question}}</summary>{{ppp:faq:6:answer}}</details><details><summary>{{ppp:faq:7:question}}</summary>{{ppp:faq:7:answer}}</details></div><!-- site-intent:end --><details>\n            <summary>{{ppp:faq:8:question}}</summary>{{ppp:faq:8:answer}}</details>\n          <details>\n            <summary>{{ppp:faq:9:question}}</summary>{{ppp:faq:9:answer}}</details>\n          <details>\n            <summary>{{ppp:faq:10:question}}</summary>{{ppp:faq:10:answer}}</details>\n          <details>\n            <summary>{{ppp:faq:11:question}}</summary>{{ppp:faq:11:answer}}</details>\n          <details>\n            <summary>{{ppp:faq:12:question}}</summary>{{ppp:faq:12:answer}}</details>\n          <details>\n            <summary>{{ppp:faq:13:question}}</summary>{{ppp:faq:13:answer}}</details>\n          <details>\n            <summary>{{ppp:faq:14:question}}</summary>{{ppp:faq:14:answer}}</details>\n          <details>\n            <summary>{{ppp:faq:15:question}}</summary>{{ppp:faq:15:answer}}</details>\n          <details>\n            <summary>{{ppp:faq:16:question}}</summary>{{ppp:faq:16:answer}}</details>\n          <details>\n            <summary>{{ppp:faq:17:question}}</summary>{{ppp:faq:17:answer}}</details>\n          <details>\n            <summary>{{ppp:faq:18:question}}</summary>{{ppp:faq:18:answer}}</details>\n        </div>\n      </section>" as TrustedHtml,
"items": [
{
"question": "Why can an online guide price differ from the written quote?",
"answer": "<p>A guide range describes a standard scope; the property may need different access, materials, investigation or additional work. Ask the team to identify the inclusions and approval boundaries in the written quote rather than treating an online range as a fixed offer.</p>" as TrustedHtml
},
{
"question": "Can I approve investigation without approving every possible repair?",
"answer": "<p>Discuss the initial assessment scope and the person authorised to approve it. If further repair or replacement is proposed, ask what needs separate agreement. An enquiry or access arrangement alone is not approval of unlimited work.</p>" as TrustedHtml
},
{
"question": "What are your routine hours and emergency arrangements?",
"answer": "<p>Routine service hours: 09:00–21:00, seven days a week. 24-hour emergency repairs are available; call to confirm attendance arrangements and the quoted emergency work. No arrival time is guaranteed. Emergency repair fees follow the quoted work plan. For urgent work, call rather than relying on an online enquiry.</p>" as TrustedHtml
},
{
"question": "Can a hidden water leak cause a high bill without visible water damage?",
"answer": "<p>Yes, a concealed leak is possible without visible damage. A bill increase alone is insufficient to diagnose one. <a href=\"water-leak-detection-perth.html#learn-about-water-leak-detection-perth\">Read the explanation.</a></p>" as TrustedHtml
},
{
"question": "What is the difference between an RCD and a circuit breaker?",
"answer": "<p>An RCD detects leakage imbalance; a circuit breaker responds to overload or short circuit. A combined device can do both. <a href=\"safety-switch-tripping-perth.html#learn-about-safety-switch-tripping-perth\">Read the explanation.</a></p>" as TrustedHtml
},
{
"question": "Why has my hot water suddenly stopped working?",
"answer": "<p>Several supply, heating or plumbing faults can interrupt hot water. The system type and affected outlets guide assessment. <a href=\"hot-water-problems-perth.html#learn-about-hot-water-problems-perth\">Read the explanation.</a></p>" as TrustedHtml
},
{
"question": "What is the difference between a running toilet and a leaking toilet base?",
"answer": "<p>A running cistern passes or replenishes water internally; a base leak is external water with a source that needs checking. <a href=\"toilet-repairs-perth.html#learn-about-toilet-repairs-perth\">Read the explanation.</a></p>" as TrustedHtml
},
{
"question": "Who should a tenant contact first about plumbing or electrical repairs?",
"answer": "<p>For routine repairs, report to the agent or landlord. For immediate danger, use the appropriate emergency channel first. <a href=\"property-management.html#learn-about-property-management\">Read the explanation.</a></p>" as TrustedHtml
},
{
"question": "What is Ellis Services Group?",
"answer": "\n            <p>\n              Ellis Services Group is part of the Ellis Group, with a dedicated\n              Perth repair team providing plumbing and electrical repairs and\n              maintenance across Perth for homes, rentals, strata properties\n              and commercial premises.\n            </p>\n          " as TrustedHtml
},
{
"question": "Which areas does Ellis Services Group cover?",
"answer": "\n            <p>\n              Our dedicated Perth repair team provides plumbing and electrical\n              services across Perth. Include the property suburb and service\n              required so we can prepare for the work.\n            </p>\n          " as TrustedHtml
},
{
"question": "What information should I provide?",
"answer": "\n            <p>\n              Provide the property address, affected area, factual description,\n              when it began, whether it is active or worsening, and the best\n              access contact. Property managers should include a work-order\n              reference and approval pathway.\n            </p>\n          " as TrustedHtml
},
{
"question": "Can I send photos?",
"answer": "\n            <p>\n              Photos are optional: email safely taken photos to maxinemaintenance.au@outlook.com. You can contact us without photos. Do not approach exposed wiring, active sparking, wet electrical equipment or another hazard to take a photo.\n            </p>\n          " as TrustedHtml
},
{
"question": "\n              What if I do not know whether the problem is plumbing or\n              electrical?\n            ",
"answer": "\n            <p>\n              Describe what you observe rather than guessing. Our Perth team\n              will identify the appropriate plumbing or electrical service path.\n            </p>\n          " as TrustedHtml
},
{
"question": "\n              Should I use the blocked drain or blocked toilet page?\n            ",
"answer": "\n            <p>\n              Use Blocked Drains &amp; Toilets for slow drainage, gurgling,\n              backups or a blocked toilet. Use Toilet Repairs when the concern\n              is specifically a running, leaking, slow-filling or\n              non-functioning toilet.\n            </p>\n          " as TrustedHtml
},
{
"question": "What should I do if a pipe bursts?",
"answer": "\n            <p>\n              Put people and electrical safety first. If it is safe and\n              familiar, isolate the water supply; otherwise keep clear and use\n              the Burst Pipe Repair page to share the affected area and active\n              water details.\n            </p>\n          " as TrustedHtml
},
{
"question": "\n              What should I do if a safety switch keeps tripping?\n            ",
"answer": "\n            <p>\n              Do not repeatedly reset it. Note which areas lost power and what\n              equipment was being used. Do not open the switchboard or work on\n              fixed wiring.\n            </p>\n          " as TrustedHtml
},
{
"question": "When is Ellis Services Group available?",
"answer": "\n            <p>\n              Routine service hours: 09:00–21:00, seven days a week. 24-hour emergency repairs are available; call to confirm attendance arrangements and the quoted emergency work. No arrival time is guaranteed.\n            </p>\n          " as TrustedHtml
},
{
"question": "Are licence details available?",
"answer": "\n            <p>\n              Services are provided by appropriately licensed plumbing and electrical tradespeople. Current licence details are available on request for procurement or property management.\n            </p>\n          " as TrustedHtml
},
{
"question": "When should I call 000?",
"answer": "\n            <p>\n              Call 000 for life-threatening emergencies, fire, smoke, active\n              arcing or immediate danger. Move to a safe location first. Once the immediate hazard is made safe, contact Ellis Services Group to arrange the repair assessment.\n            </p>\n          " as TrustedHtml
}
]
},
