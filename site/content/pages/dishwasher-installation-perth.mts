"hero": "\n<section class=\"page-hero\"><div class=\"shell service-reading\">{{ppp:breadcrumbs}}<span class=\"eyebrow\">Ellis Services Group · Perth</span><h1>Dishwasher Installation &amp; Connections Perth</h1><p class=\"expanded-lead\">Dishwasher installation and water connections in Perth, including supply, removal of the old unit and taking it away as part of the agreed installation package. We check the appliance, space and existing connections before quoting.</p><p><a class=\"button\" href=\"tel:0413477667\">Call 0413 477 667</a> <a class=\"button service-book-button\" href=\"contact.html?service=dishwasher-installation-perth.html\">Arrange a visit &amp; quote</a></p><p class=\"expanded-hours\">Routine service hours: 09:00–21:00, seven days a week. 24-hour emergency repairs are available; call to confirm attendance arrangements and the quoted emergency work. No arrival time is guaranteed.</p><nav aria-label=\"On this page\" class=\"expanded-toc\"><a href=\"#service-scope\">Service scope</a><a href=\"#service-scenarios\">Common situations</a><a href=\"#service-quote\">Process &amp; quote</a><a href=\"#service-faq\">FAQs</a></nav></div></section>" as TrustedHtml,
"sections": [
