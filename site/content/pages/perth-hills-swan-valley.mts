"hero": "<section class=\"page-hero\"><div class=\"shell\">{{ppp:breadcrumbs}}<span class=\"eyebrow\">Ellis Services Group · Perth local team</span><h1>Perth Hills &amp; Swan Valley Plumber &amp; Electrician</h1><p>Perth Hills and Swan Valley plumbing and electrical repairs for hot-water problems, electrical faults, lighting, blocked drains and visible leak concerns.</p><a class=\"button\" href=\"tel:0413477667\">Call 0413 477 667</a> <a class=\"button\" href=\"contact.html\">Request a repair in Perth Hills &amp; Swan Valley</a></div></section>" as TrustedHtml,
"sections": [
