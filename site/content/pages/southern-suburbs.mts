"container": "\n<section class=\"section faq\"><div class=\"shell text-column regional-guide\"><h2>Southern Suburbs plumber and electrician FAQ</h2><!-- site-intent:start --><div class=\"intent-content\" data-site-intent><h3>Keep each property and repair request distinct</h3><p>For an owner or manager arranging several jobs, keep the street address, occupant report and approval contact with each task. Do not use one suburb selection as an instruction for several properties. When the issue is near a boundary, shared pipe or external supply, describe the location without assuming ownership or a repair responsibility.</p><ul class=\"intent-links\"><li><a href=\"property-management.html\">Separate work orders and approval contacts</a></li><li><a href=\"blocked-drains-perth.html\">Drainage symptoms and responsibility boundaries</a></li><li><a href=\"electrical.html\">Electrician enquiries for Canning Vale and southern Perth</a></li><li><a href=\"plumbing.html\">Plumbing services in southern Perth</a></li></ul><details><summary>{{ppp:faq:0:question}}</summary>{{ppp:faq:0:answer}}</details></div><!-- site-intent:end --><details><summary>{{ppp:faq:1:question}}</summary>{{ppp:faq:1:answer}}</details><details><summary>{{ppp:faq:2:question}}</summary>{{ppp:faq:2:answer}}</details></div></section>" as TrustedHtml,
