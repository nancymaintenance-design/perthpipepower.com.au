"hero": "<section class=\"page-hero\"><div class=\"shell\">{{ppp:breadcrumbs}}<span class=\"eyebrow\">Ellis Services Group · Perth local team</span><h1>Southern Suburbs Plumber &amp; Electrician</h1><p>Southern Suburbs plumbing and electrical repairs for drainage, leaks, hot-water problems, electrical faults, lighting and power-point concerns.</p><a class=\"button\" href=\"tel:0413477667\">Call 0413 477 667</a> <a class=\"button\" href=\"contact.html\">Request a repair in Southern Suburbs</a></div></section>" as TrustedHtml,
"sections": [
