"hero": "<section class=\"page-hero\"><div class=\"shell\">{{ppp:breadcrumbs}}<span class=\"eyebrow\">Ellis Services Group · Perth local team</span><h1>Northern Suburbs Plumber &amp; Electrician</h1><p>Northern Suburbs plumbing and electrical repairs for power faults, safety switches, hot-water problems, blocked drains and visible leak concerns.</p><a class=\"button\" href=\"tel:0413477667\">Call 0413 477 667</a> <a class=\"button\" href=\"contact.html\">Request a repair in Northern Suburbs</a></div></section>" as TrustedHtml,
"sections": [
