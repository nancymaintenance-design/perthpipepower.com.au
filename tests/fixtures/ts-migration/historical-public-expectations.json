  "hero": "<section class=\"hero\" aria-label=\"Featured services\">\n        <article\n          class=\"slide is-active\"\n          style=\"background-image: url(&quot;hero-repair.jpg&quot;)\"\n        >\n          <div class=\"shell\">\n            <div class=\"hero-copy\">\n              <span class=\"eyebrow\">Perth plumbing &amp; electrical repairs</span>\n              <h1>Plumbing and electrical repairs in Perth</h1>\n              <p>\n                Clear help for property problems. Ellis Services Group is a\n                direct place to start when a plumbing or electrical issue\n                interrupts your Perth property.\n              </p>\n              <div class=\"hero-actions\">\n                <a class=\"button\" href=\"tel:0413477667\">Call 0413 477 667</a\n                ><a class=\"button alt\" href=\"contact.html\">Request a repair</a>\n              </div>\n            </div>\n          </div>\n        </article>\n        <article class=\"slide\" data-background-image=\"plumbing-repair.jpg\">\n          <div class=\"shell\">\n            <div class=\"hero-copy\">\n              <span class=\"eyebrow\">Plumbing</span>\n              <h2>Describe the water problem, simply.</h2>\n              <p>\n                Leaks, slow drains and hot-water symptoms are easier to action\n                when the location and observations are clear.\n              </p>\n              <div class=\"hero-actions\">\n                <a class=\"button\" href=\"plumbing.html\">Explore plumbing</a>\n              </div>\n            </div>\n          </div>\n        </article>\n        <article class=\"slide\" data-background-image=\"electrical-repair.jpg\">\n          <div class=\"shell\">\n            <div class=\"hero-copy\">\n              <span class=\"eyebrow\">Electrical</span>\n              <h2>Safety first. Facts next.</h2>\n              <p>\n                For electrical faults, report what you can observe from a safe\n                position. Never dismantle equipment to diagnose a problem.\n              </p>\n              <div class=\"hero-actions\">\n                <a class=\"button\" href=\"electrical.html\">Explore electrical</a>\n              </div>\n            </div>\n          </div>\n        </article>\n        <div class=\"carousel-controls\">\n          <button type=\"button\" data-prev aria-label=\"Previous slide\">←</button\n          ><span class=\"carousel-status\" aria-live=\"polite\">1 of 3</span\n          ><button type=\"button\" data-next aria-label=\"Next slide\">→</button>\n        </div>\n      </section>",
  "restoredHero": "<section class=\"hero\" aria-label=\"Featured services\">\n        <article\n          class=\"slide is-active\"\n          style=\"background-image: url(&quot;hero-repair.jpg&quot;)\"\n        >\n          <div class=\"shell\">\n            <div class=\"hero-copy\">\n              <span class=\"eyebrow\">Perth plumbing &amp; electrical repairs</span>\n              <h1>Plumbing and electrical repairs in Perth</h1>\n              <p>\n                Clear help for property problems. Ellis Services Group is a\n                direct place to start when a plumbing or electrical issue\n                interrupts your Perth property.\n              </p>\n              <div class=\"hero-actions\">\n                <a class=\"button\" href=\"tel:0413477667\">Call 0413 477 667</a\n                ><a class=\"button alt\" href=\"contact.html\">Request a repair</a>\n              </div>\n            </div>\n          </div>\n        </article>\n        <article class=\"slide\" data-background-image=\"plumbing-repair.jpg\">\n          <div class=\"shell\">\n            <div class=\"hero-copy\">\n              <span class=\"eyebrow\">Plumbing</span>\n              <h2>Describe the water problem, simply.</h2>\n              <p>\n                Leaks, slow drains and hot-water symptoms are easier to action\n                when the location and observations are clear.\n              </p>\n              <div class=\"hero-actions\">\n                <a class=\"button\" href=\"plumbing.html\">Explore plumbing</a>\n              </div>\n            </div>\n          </div>\n        </article>\n        <article class=\"slide\" data-background-image=\"electrical-repair.jpg\">\n          <div class=\"shell\">\n            <div class=\"hero-copy\">\n              <span class=\"eyebrow\">Electrical</span>\n              <h2>Safety first. Facts next.</h2>\n              <p>\n                For electrical faults, report what you can observe from a safe\n                position. Never dismantle equipment to diagnose a problem.\n              </p>\n              <div class=\"hero-actions\">\n                <a class=\"button\" href=\"electrical.html\">Explore electrical</a>\n              </div>\n            </div>\n          </div>\n        </article>\n        <div class=\"carousel-controls\">\n          <button type=\"button\" data-prev aria-label=\"Previous slide\">←</button\n          ><span class=\"carousel-status\" aria-live=\"polite\">1 of 3</span\n          ><button type=\"button\" data-next aria-label=\"Next slide\">→</button>\n        </div>\n      </section>",
  "privacy": "<!doctype html>\n<html lang=\"en-AU\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n    <title>Privacy Policy | Ellis Services Group</title>\n    <meta name=\"description\" content=\"How Ellis Services Group handles personal information submitted through this Perth plumbing and electrical website.\" />\n    <meta name=\"robots\" content=\"noindex,follow\" />\n    <link rel=\"canonical\" href=\"https://perthpipepower.com.au/privacy.html\" />\n    <meta property=\"og:title\" content=\"Privacy Policy | Ellis Services Group\" />\n    <meta property=\"og:description\" content=\"How Ellis Services Group handles personal information submitted through this Perth plumbing and electrical website.\" />\n    <meta property=\"og:url\" content=\"https://perthpipepower.com.au/privacy.html\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <link rel=\"stylesheet\" href=\"site.css\" />\n    <link rel=\"stylesheet\" href=\"logo.css\" />\n    <link rel=\"stylesheet\" href=\"navigation.css\" />\n    <link rel=\"stylesheet\" href=\"mega-menu.css\" />\n    <link rel=\"stylesheet\" href=\"title-banner.css\" />\n    <link rel=\"stylesheet\" href=\"mobile-refinement.css\" />\n    <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-HZ6PKHKGWH\"></script>\n    <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', 'G-HZ6PKHKGWH');</script>\n    <script>window.si=window.si||function(){(window.siq=window.siq||[]).push(arguments)};</script>\n  <script defer src=\"/_vercel/speed-insights/script.js\"></script>\n</head>\n  <body>\n    <a class=\"skip\" href=\"#main\">Skip to content</a>\n    <header class=\"site-header\">\n      <div class=\"shell head-row\">\n        <a class=\"brand\" href=\"/\"><img class=\"brand-logo\" src=\"ellis-services-logo.png\" width=\"1237\" height=\"1272\" alt=\"Ellis Services Group logo\" />Ellis Services Group</a>\n        <nav class=\"site-nav\" aria-label=\"Main navigation\"><ul class=\"nav-list\"><li><a href=\"/\">Home</a></li><li><a href=\"about.html\">About</a></li><li><a href=\"service-areas.html\">Areas</a></li><li><a href=\"contact.html\" class=\"nav-cta\">Contact</a></li></ul></nav>\n      </div>\n    </header>\n    <main id=\"main\">\n      <section class=\"page-hero\"><div class=\"shell\"><p class=\"breadcrumbs\"><a href=\"/\">Home</a> / Privacy Policy</p><span class=\"eyebrow\">Your information</span><h1>Privacy policy</h1><p>How Ellis Services Group handles information you provide through this website.</p></div></section>\n      <section class=\"section\"><div class=\"shell text-column\">\n        <h2>Information we collect</h2>\n        <p>When you send an enquiry, we may collect your name, phone number, email address and property address or suburb, together with the service details you choose to provide.</p>\n        <h2>How we use it</h2>\n        <p>We use enquiry information to respond to your request, discuss plumbing or electrical work, arrange access where appropriate and keep records connected with the enquiry or completed work.</p>\n        <h2>Keeping information secure</h2>\n        <p>Provide only information that is relevant to the request. Do not include unnecessary sensitive information or take photos that place you near an electrical, water or other safety hazard.</p>\n        <h2>Contact and updates</h2>\n        <p>For a privacy question or to update information you have submitted, contact Ellis Services Group at <a href=\"mailto:maxinemaintenance.au@outlook.com\">maxinemaintenance.au@outlook.com</a> or call <a href=\"tel:0413477667\">0413 477 667</a>.</p>\n      </div></section>\n    </main>\n    <footer class=\"footer\"><div class=\"shell\"><p>Ellis Services Group · <a href=\"tel:0413477667\">0413 477 667</a> · <a href=\"mailto:maxinemaintenance.au@outlook.com\">maxinemaintenance.au@outlook.com</a> · 140 St Georges Terrace, Perth WA 6000 · <a href=\"privacy.html\">Privacy Policy</a></p></div></footer>\n    <script src=\"site.js\"></script><script src=\"navigation.js\"></script>\n  </body>\n</html>\n",
