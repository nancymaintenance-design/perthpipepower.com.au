{
  "name": "perth-pipe-power",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "editor:compile": "tsc -p tsconfig.json && tsc -p tsconfig.editor.json",
    "editor:dev": "npm run editor:compile && node .build/tools/editor/server.mjs",
    "test:editor": "npm run editor:compile && node --test tests/localization-fields.test.cjs tests/editor-store.test.cjs tests/editor-server.test.cjs",
    "test:editor:browser": "npm run editor:compile && node --test tests/editor-preview.browser.cjs",
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run compile && node .build/site/build/cli.mjs",
    "test": "npm run build && node scripts/run-tests.cjs",
    "test:browser": "playwright test",
    "validate:seo": "node scripts/validate-seo.js --root dist",
    "baseline:freeze": "npm run compile && node .build/tools/migration-baseline.mjs freeze"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "parse5": "8.0.1",
    "typescript": "7.0.2"
  }
}
