export async function seedHomepage(sourceRoot:string):Promise<void>{
 const root=join(sourceRoot,'.local-editor','drafts');if(await readDraft(root,'index.html'))return;
 const site=loadSiteData(),page=site.pages.find(p=>p.file==='index.html')!,changes:Record<string,string>={};
 for(const field of collectEditableFields(page,site)){const value=homepage[field.value.replace(/\s+/g,' ').trim()];if(value&&!field.locked)changes[field.id]=value;}
 await saveDraft(root,{pageId:page.file,expectedRevision:0,baseHash:pageHash(page),changes});
}
